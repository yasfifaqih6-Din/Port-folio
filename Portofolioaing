<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Modern Portfolio</title>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html{
      scroll-behavior:smooth;
    }

    body{
      font-family: Arial, Helvetica, sans-serif;
      overflow-x:hidden;
      background:#0b0b0b;
    }

    /* =========================
       HERO BACKGROUND
    ========================== */

    .hero-bg{
      position:relative;
      overflow:hidden;
    }

    .hero-bg::before{
      content:"";
      position:absolute;
      inset:0;
      background:
      radial-gradient(circle at top,
      rgba(255,255,255,0.12),
      transparent 40%);
      pointer-events:none;
    }

    .curve{
      position:absolute;
      border:1px solid rgba(255,255,255,0.08);
      border-radius:50%;
      pointer-events:none;
    }

    /* =========================
       GRADIENT TEXT
    ========================== */

    .gradient-text{
      background:linear-gradient(to right,#38bdf8,#d946ef);
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
    }

    /* =========================
       GLASS EFFECT
    ========================== */

    .glass{
      background:rgba(255,255,255,0.05);
      backdrop-filter:blur(10px);
      border:1px solid rgba(255,255,255,0.08);
    }

    /* =========================
       REFRESH ANIMATION
    ========================== */

    .intro{
      opacity:0;
      transform:translateY(80px);
      animation:introBounce 1.3s forwards;
    }

    .intro-delay-1{
      animation-delay:0.2s;
    }

    .intro-delay-2{
      animation-delay:0.4s;
    }

    .intro-delay-3{
      animation-delay:0.6s;
    }

    @keyframes introBounce{
      0%{
        opacity:0;
        transform:translateY(100px);
      }

      60%{
        opacity:1;
        transform:translateY(-10px);
      }

      80%{
        transform:translateY(5px);
      }

      100%{
        opacity:1;
        transform:translateY(0);
      }
    }

    /* =========================
       SCROLL REVEAL
    ========================== */

    .reveal{
      opacity:0;
      transform:translateY(100px);
      transition:
      opacity 1s ease,
      transform 1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal.active{
      opacity:1;
      transform:translateY(0);
      animation:scrollBounce 1s ease;
    }

    @keyframes scrollBounce{
      0%{
        transform:translateY(100px);
      }

      60%{
        transform:translateY(-10px);
      }

      80%{
        transform:translateY(4px);
      }

      100%{
        transform:translateY(0);
      }
    }

    /* =========================
       NAVBAR LINK
    ========================== */

    .nav-link{
      position:relative;
      transition:0.3s;
    }

    .nav-link::after{
      content:'';
      position:absolute;
      width:0%;
      height:2px;
      background:#38bdf8;
      left:0;
      bottom:-5px;
      transition:0.3s;
    }

    .nav-link:hover::after{
      width:100%;
    }

  </style>
</head>

<body>

  <!-- =========================
       HERO SECTION
  ========================== -->

  <section class="hero-bg min-h-screen bg-black text-white relative">

